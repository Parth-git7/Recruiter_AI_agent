# Port for the web application
PORT=3000

# ==============================================================================
# Microsoft AI Foundry Configuration
# ==============================================================================
# 1. FOUNDRY_PROJECT_ENDPOINT:
# Can be obtained from the Azure AI Foundry portal (https://ai.azure.com/):
# Navigate to your Project -> Project Settings / Overview.
# Format is typically:
# https://<your-ai-services-resource>.services.ai.azure.com/api/projects/<your-project-name>
# Or the Project Connection String if copying from Project Overview.
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# 2. Agent Name or Agent ID:
# Existing agent name configured in your Foundry playground
FOUNDRY_AGENT_NAME=candidate-matchmaker
# Optional: specify the direct Agent ID if you prefer bypassing lookup
# FOUNDRY_AGENT_ID=asst_...

# ==============================================================================
# Azure Authentication (Entra ID / Service Principal)
# ==============================================================================
# DefaultAzureCredential will automatically pick up:
# 1. Environment variables below (if configured for Service Principal)
# 2. Azure Developer CLI / Azure CLI if logged in locally (e.g. `az login`)
# 3. Azure Managed Identity if running inside Azure
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
